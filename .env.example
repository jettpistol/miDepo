# Without DATABASE_URL, miDepo uses an embedded database in ./.data (only for trying it on your machine).
# In production, paste the Postgres connection string here (for example, the one from Neon).
DATABASE_URL=

# Public address of the site, with no trailing slash. Needed for passkeys.
APP_URL=http://localhost:3000

# Long random text. Protects the PINs. Generate it with: openssl rand -hex 32
SECRET=

# "yes" loads the demo data (Ovnipress + Librería Demo) when the database is empty.
DEMO_DATA=yes
