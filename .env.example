# Sin DATABASE_URL, miDepo usa una base embebida en ./.data (solo para probar en tu máquina).
# En producción, pegá acá la cadena de conexión de Postgres (por ejemplo, la de Neon).
DATABASE_URL=

# Dirección pública del sitio, sin barra final. Necesaria para las llaves de acceso (passkeys).
APP_URL=http://localhost:3000

# Texto largo y aleatorio. Protege los PIN. Generalo con: openssl rand -hex 32
SECRETO=

# "si" carga datos de demostración (Ovnipress + Librería Demo) cuando la base está vacía.
DATOS_DEMO=si
