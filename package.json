{
  "name": "midepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:setup && next dev",
    "build": "next build",
    "build:prod": "npm run db:setup && next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx src/db/setup.ts",
    "db:reset": "tsx src/db/setup.ts --reset",
    "empresa:crear": "tsx src/db/crear-empresa.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "barcode-detector": "^3.2.4",
    "bwip-js": "^4.11.4",
    "drizzle-orm": "^0.45.4",
    "marked": "^18.2.1",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
